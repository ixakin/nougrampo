{
  "name": "nougrampo",
  "compatibility_date": "2026-10-20",
  "main": "worker.js",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nougrampo-products",
      "database_id": "660f2735-af3d-4abb-adf1-6a0caf03fa6e",
      "migrations_dir": "migrations"
    }
  ],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page"
  }
}
